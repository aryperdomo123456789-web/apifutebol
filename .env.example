# ============================================================
# API FUT 24/7 - Variaveis de ambiente
# Copie este arquivo para .env e ajuste os valores
# NUNCA versione o arquivo .env com valores reais
# ============================================================

# --- Aplicacao ---
APP_NAME=apifutebol
APP_ENV=development
APP_PORT=3000
APP_GLOBAL_PREFIX=api
APP_VERSION=v1

# --- Logging ---
# levels: fatal | error | warn | info | debug | trace
LOG_LEVEL=info
# true habilita pino-pretty em desenvolvimento
LOG_PRETTY=true

# --- Banco de dados (MariaDB) ---
DB_TYPE=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=apifut
DB_PASSWORD=change-me
DB_DATABASE=apifutebol
# NUNCA use true em producao
DB_SYNCHRONIZE=false
DB_LOGGING=false
DB_CHARSET=utf8mb4
DB_TIMEZONE=Z

# --- Fontes de dados externas (Fase 4+) ---
# Preenchidas em fases posteriores. Deixe em branco por enquanto.
FUTEBOL_NA_TV_BASE_URL=
THESPORTSDB_API_KEY=
SPORTMONKS_API_KEY=
API_FOOTBALL_KEY=
